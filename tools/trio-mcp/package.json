{
  "name": "trio-mcp",
  "version": "0.1.0",
  "description": "Provider-independent MCP relay for Trio. AI assistants can read settings and propose locally approved changes.",
  "type": "module",
  "bin": {
    "trio-mcp": "trio-mcp.mjs"
  },
  "scripts": {
    "test": "node --test *.test.mjs",
    "serve": "node trio-mcp.mjs serve",
    "mcp": "node trio-mcp.mjs mcp",
    "info": "node trio-mcp.mjs info"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "zod": "4.6.7"
  }
}
