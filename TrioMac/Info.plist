	<dict>
		<key>UIColorName</key>
		<string>Background_DarkBlue</string>
		<key>UIImageName</key>
		<string>trioCircledNoBackground</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<false/>
